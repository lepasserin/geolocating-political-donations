@article{gimpel_check_2008,
	title = {The {Check} {Is} in the {Mail}: {Interdistrict} {Funding} {Flows} in {Congressional} {Elections}},
	volume = {52},
	issn = {0092-5853},
	shorttitle = {The {Check} {Is} in the {Mail}},
	url = {https://www.jstor.org/stable/25193819},
	abstract = {This article analyzes the financial ties between congressional candidates and individual donors residing outside those candidates' districts. Congressional campaigns today rely more heavily on nonresidents than in the past, with contests in the typical district drawing more than two-thirds of individual donations from nonresidents. Empirical results reveal that nonresident contributions are primarily partisan and strategic in nature, rather than access-oriented or expressive/identity-based. Funds are efficiently redistributed from a small number of highly educated, wealthy congressional districts to competitive districts anywhere in the country. Big donors direct funds where they can make a difference for party control of seats, even if those investments are hundreds, or even thousands, of miles away.},
	number = {2},
	urldate = {2026-05-23},
	journal = {American Journal of Political Science},
	publisher = {[Midwest Political Science Association, Wiley]},
	author = {Gimpel, James G. and Lee, Frances E. and Pearson-Merkowitz, Shanna},
	year = {2008},
	pages = {373--394},
	file = {Full Text PDF:/Users/benedictcummins-mburu/Zotero/storage/HEIVPKRS/Gimpel et al. - 2008 - The Check Is in the Mail Interdistrict Funding Flows in Congressional Elections.pdf:application/pdf},
}

