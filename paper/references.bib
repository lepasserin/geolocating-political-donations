@inbook{waters_geography_2018,
author = {Waters, Nigel},
publisher = {John Wiley & Sons, Ltd},
isbn = {9781118786352},
title = {Tobler's First Law of Geography},
booktitle = {International Encyclopedia of Geography},
chapter = {},
pages = {1-15},
doi = {https://doi.org/10.1002/9781118786352.wbieg1011.pub2},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118786352.wbieg1011.pub2},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781118786352.wbieg1011.pub2},
year = {2018},
keywords = {geographic theory, geovisualization, GIScience, network theory, social networks, spatial analysis, spatial modeling, spatial statistics, spatial thinking, urban geography},
abstract = {Tobler's first law (TFL) of geography was introduced into the geographical literature in an article that Waldo Tobler published in the journal Economic Geography in 1970. In this article, which described a simulation of population growth in Detroit, Tobler stated that to make his model operational he would “invoke the first law of geography: everything is related to everything else, but near things are more related than distant things.” This entry considers whether TFL is an accurate description of the real world. Specifically, it considers the following questions: Is TFL really a law and, if so, is it the most important law in geography? Do modern spatial interpolation techniques allow the model to be operationalized? How can “near” and “distant” be measured? Is it true for Euclidean and network space? Do classic models of human and urban geography conform to TFL?}
}

